Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:docs|tests|third_party|runtime|output|\.git)(?:/|$) - [F,L,NC]
</IfModule>
<FilesMatch "(?i)\.(sql|md|json|lock|log|ini|env|ps1)$|^\.env(?:\.|$)|^(config(?:\.local|\.example)?|bootstrap|db|auth|functions|layout|services|mailer|student_form|teacher_form|setup_admin)\.php$">
  Require all denied
</FilesMatch>
